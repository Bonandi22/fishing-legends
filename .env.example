# Backend configuration. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8090
DATABASE_URL=
ACCESS_TOKEN_SECRET=
LOG_LEVEL=info
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Comma-separated list of allowed browser origins, or `*`. Empty = no
# Access-Control-Allow-Origin header is sent (same-origin only). An arbitrary
# Origin is never reflected.
CORS_ORIGINS=

# Per-client request budget (see TRUST_PROXY for how the client is identified).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Separate, tighter budget for POST /auth/login and /auth/register.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=300000

# X-Forwarded-For handling. Keep `false` unless the API runs behind a proxy/LB;
# then set `true` or a comma-separated list of trusted proxy addresses/CIDRs.
# When false, rate limiting keys on the socket address and cannot be spoofed.
TRUST_PROXY=false

# Cookies (auth). false only for local http dev.
COOKIE_SECURE=false
COOKIE_DOMAIN=
