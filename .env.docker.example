# Copy to .env.docker (git-ignored) before `docker compose up`.
# .env.docker holds only local/dev values — never real secrets.

NODE_ENV=development
LOG_LEVEL=info

# Backend HTTP
HOST=0.0.0.0
PORT=8090

# Database (matches the postgres service in compose.yaml)
DATABASE_URL=postgres://deepbluelure:deepbluelure@postgres:5432/deepbluelure

# Auth — dev-only secret, must be at least 32 characters
ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me-please
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Security
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Tighter, separate budget for POST /auth/login and /auth/register. Keyed on
# request.ip like the general limiter, so with TRUST_PROXY=false every client
# behind the proxy shares this bucket — 20 / 5 min is loose enough for that.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=300000
# All browser traffic reaches the backend through the frontend's /api proxy
# (Vite in dev, nginx in prod), so request.ip is the proxy's address and, with
# TRUST_PROXY=false, every browser client shares one rate-limit bucket.
# For per-client rate limiting set TRUST_PROXY to the proxy's address/CIDR — not
# `true`, because compose also publishes 8090:8090, so the backend is reachable
# directly and any caller could then spoof X-Forwarded-For.
TRUST_PROXY=false

# Cookies (auth). false only for local http dev.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Account security: email (RabbitMQ + Mailpit, see compose.yaml) and auth codes.
# Dev-only values — Mailpit UI at http://localhost:8025, RabbitMQ UI at :15672.
# AMQP broker URL (percent-encode special characters in the password)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
# SMTP relay (Mailpit catches all mail in dev; set SMTP_USER/SMTP_PASSWORD for an authenticated relay)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# Sender shown on every email
EMAIL_FROM=Fishing Legends <no-reply@localhost>
# Required whenever DATABASE_URL is set; at least 32 characters
AUTH_CODE_SECRET=dev-auth-code-secret-change-me-please-0123
# Code validity in seconds (30 min)
AUTH_CODE_TTL_SECONDS=1800
# Wrong-code attempts allowed per code
AUTH_CODE_MAX_ATTEMPTS=5
# Minimum seconds between code resends
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
